# RP Canteen - Environment Configuration Template
# Copy this file to server/.env and adjust values if needed.

# Server Port
PORT=5000

# MongoDB URI (Compass compatible)
MONGODB_URI=mongodb://127.0.0.1:27017/rp_canteen

# JWT Secret key for signing authentication tokens
JWT_SECRET=your_jwt_secret_change_in_production_min_32_chars

# Token Expiration
JWT_EXPIRES_IN=24h

# Allowed Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
